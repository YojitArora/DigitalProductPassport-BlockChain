{
  "name": "digital-product-passport",
  "version": "1.0.0",
  "description": "Blockchain-Based Digital Product Passport System",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts --network ganache",
    "deploy:ganache": "hardhat run scripts/deploy.ts --network ganache",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "demo:setup": "hardhat run scripts/seed-demo.ts --network ganache",
    "seed:demo": "hardhat run scripts/seed-demo.ts --network ganache",
    "demo:reset": "hardhat run scripts/reset-demo.ts --network ganache",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:preview": "npm run preview --prefix frontend",
    "dev": "npm run frontend:dev",
    "build": "npm run compile && npm run frontend:build"
  },
  "keywords": [
    "blockchain",
    "solidity",
    "ethereum",
    "digital-product-passport",
    "react",
    "vite",
    "hardhat"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.14.0",
    "mocha": "^11.8.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
